{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile NebOs Bootloader",
            "type": "shell",
            "command": "make",
            "args": [
                "bootloader"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}
